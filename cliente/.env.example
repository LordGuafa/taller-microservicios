PORT=3001

# Conexión a PostgreSQL que usan Prisma (src/config/database.ts) y su CLI (prisma.config.ts).
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# dotenv no expande variables como ${DB_USER}: escribe la URL completa.
# Con Docker, el contenedor postgres-cliente publica su puerto en localhost:5433.
DATABASE_URL=postgresql://cliente_user:cliente_pass_123@localhost:5433/cliente_db
